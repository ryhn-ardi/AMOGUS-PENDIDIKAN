rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64;
    }

    // Default deny for unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test probe
    match /rooms/__connection_test__ {
      allow read, write: if true;
    }

    // Rooms collection: open read, write, and update for multiplayer coordination
    match /rooms/{roomCode} {
      allow read: if isValidId(roomCode);
      allow create, update, delete: if isValidId(roomCode);

      // Players subcollection: allows all participants to join, update position, hp, tasks, or leave
      match /players/{playerId} {
        allow read: if isValidId(roomCode) && isValidId(playerId);
        allow create, update, delete: if isValidId(roomCode) && isValidId(playerId);
      }

      // Events subcollection: live chat, bullets, eliminations, game start announcements
      match /events/{eventId} {
        allow read: if isValidId(roomCode) && isValidId(eventId);
        allow create, update, delete: if isValidId(roomCode) && isValidId(eventId);
      }
    }
  }
}
