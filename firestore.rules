rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for unhandled paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test probe
    match /rooms/__connection_test__ {
      allow read, write: if true;
    }

    // Rooms collection: allow open read and write for room creation and active room list
    match /rooms/{roomCode} {
      allow read, write: if true;

      // Players subcollection: allow participants to join, update state, list players, or leave
      match /players/{playerId} {
        allow read, write: if true;
      }

      // Events subcollection: allow real-time events, bullets, chat, and game announcements
      match /events/{eventId} {
        allow read, write: if true;
      }
    }
  }
}
